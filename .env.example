# ─────────────────────────────────────────────────────────────
# Supabase configuration
# Copy this file to ".env" and fill in the values from your
# Supabase project dashboard:  Project Settings → API
# ─────────────────────────────────────────────────────────────

# Your project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# The public "anon" key (safe for the browser WHEN RLS is enabled).
# NEVER put the service_role key here or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=

# The single authorized user's email address.
# Any other account that authenticates is signed out immediately.
# This must match the email of the user you create in
# Supabase dashboard → Authentication → Users.
VITE_AUTHORIZED_EMAIL=
